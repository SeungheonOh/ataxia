<rml><head><title>Workspaces</title><style>
body { margin:0; width:100%; height:100%; font-size:13dp; }
div { display:block; box-sizing:border-box; }
button, input.button, input.action { display:block; box-sizing:border-box; height:var(--control); line-height:var(--control-line); padding:0 var(--gap); flex-shrink:0; }
#panel { width:100%; height:100%; padding:var(--inset); border:var(--frame) var(--ink); display:flex; flex-direction:column; gap:var(--section); }
#header { display:flex; align-items:center; justify-content:space-between; gap:var(--gap); height:var(--control); flex-shrink:0; }
#title { font-size:var(--heading); font-weight:bold; }
button { text-align:left; }
#location { font-size:12dp; flex-shrink:0; }
#body { flex:1; min-height:0; display:flex; gap:var(--section); overflow:auto; }
#groups { width:160dp; flex-shrink:0; }
.group { margin-bottom:var(--unit); width:100%; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
#group-paging { display:flex; align-items:center; justify-content:space-between; margin-top:var(--gap); }
#workspaces { flex:1; min-width:0; }
#group-heading { display:flex; align-items:center; gap:var(--gap); margin-bottom:var(--gap); }
#group-title { font-size:13dp; font-weight:bold; flex:1; }
#group-remove { font-size:10dp; }
#workspace-grid { display:flex; flex-wrap:wrap; gap:var(--gap); }
.workspace { display:none; width:30%; }
.workspace-open { width:100%; height:auto; min-height:72dp; padding:var(--gap); line-height:16dp; }
.remove { display:none; width:100%; font-size:10dp; }
#workspace-card1, #workspace-new { display:block; }
#workspace-new { height:72dp; padding:var(--gap); line-height:16dp; }
.name { font-weight:bold; }
.detail, .preview { font-size:10dp; margin-top:var(--unit); }
.preview { height:16dp; white-space:nowrap; overflow:hidden; }
#footer { display:flex; align-items:center; gap:var(--gap); flex-shrink:0; font-size:11dp; }
.small #body { display:block; }
.small #workspaces { width:100%; margin-top:var(--section); flex:none; }
.small #groups { width:100%; }
.small #workspace-grid { width:100%; }
.small .workspace { width:48%; }
</style><link type="text/rcss" href="../theme.rcss"/></head><body class="shell shell-workspaces"><div id="panel"><div id="header"><div id="title">Workspaces</div><button id="close">Close</button></div><div id="location">Choose a group, then a workspace</div><div id="body"><div id="groups"><button id="group0" class="group">Group 1</button><button id="group1" class="group">Group 2</button><button id="group2" class="group">Group 3</button><button id="group3" class="group">Group 4</button><button id="group4" class="group">Group 5</button><button id="group5" class="group">Group 6</button><div id="group-paging"><button id="group-prev">‹</button><div id="group-page">1 / 1</div><button id="group-next">›</button></div></div><div id="workspaces"><div id="group-heading"><div id="group-title">Studio</div><button id="group-remove">Remove subworld</button></div><div id="workspace-grid"><div id="workspace-card1" class="workspace"><button id="workspace1" class="workspace-open"><div id="workspace-name1" class="name">Workspace 1</div><div id="workspace-detail1" class="detail">Empty</div><div id="workspace-preview1" class="preview"/></button><button id="workspace-remove1" class="remove">Remove</button></div><div id="workspace-card2" class="workspace"><button id="workspace2" class="workspace-open"><div id="workspace-name2" class="name">Workspace 2</div><div id="workspace-detail2" class="detail">Empty</div><div id="workspace-preview2" class="preview"/></button><button id="workspace-remove2" class="remove">Remove</button></div><div id="workspace-card3" class="workspace"><button id="workspace3" class="workspace-open"><div id="workspace-name3" class="name">Workspace 3</div><div id="workspace-detail3" class="detail">Empty</div><div id="workspace-preview3" class="preview"/></button><button id="workspace-remove3" class="remove">Remove</button></div><div id="workspace-card4" class="workspace"><button id="workspace4" class="workspace-open"><div id="workspace-name4" class="name">Workspace 4</div><div id="workspace-detail4" class="detail">Empty</div><div id="workspace-preview4" class="preview"/></button><button id="workspace-remove4" class="remove">Remove</button></div><div id="workspace-card5" class="workspace"><button id="workspace5" class="workspace-open"><div id="workspace-name5" class="name">Workspace 5</div><div id="workspace-detail5" class="detail">Empty</div><div id="workspace-preview5" class="preview"/></button><button id="workspace-remove5" class="remove">Remove</button></div><div id="workspace-card6" class="workspace"><button id="workspace6" class="workspace-open"><div id="workspace-name6" class="name">Workspace 6</div><div id="workspace-detail6" class="detail">Empty</div><div id="workspace-preview6" class="preview"/></button><button id="workspace-remove6" class="remove">Remove</button></div><div id="workspace-card7" class="workspace"><button id="workspace7" class="workspace-open"><div id="workspace-name7" class="name">Workspace 7</div><div id="workspace-detail7" class="detail">Empty</div><div id="workspace-preview7" class="preview"/></button><button id="workspace-remove7" class="remove">Remove</button></div><div id="workspace-card8" class="workspace"><button id="workspace8" class="workspace-open"><div id="workspace-name8" class="name">Workspace 8</div><div id="workspace-detail8" class="detail">Empty</div><div id="workspace-preview8" class="preview"/></button><button id="workspace-remove8" class="remove">Remove</button></div><div id="workspace-card9" class="workspace"><button id="workspace9" class="workspace-open"><div id="workspace-name9" class="name">Workspace 9</div><div id="workspace-detail9" class="detail">Empty</div><div id="workspace-preview9" class="preview"/></button><button id="workspace-remove9" class="remove">Remove</button></div><button id="workspace-new" class="workspace"><div class="name">+</div><div class="detail">New workspace</div></button></div></div></div><div id="footer"><button id="overview">Overview</button><div>Apps stay open · Esc to close</div></div></div></body></rml>