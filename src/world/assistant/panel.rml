<rml><head><title>Ataxia assistant</title><style>
body { margin:0; width:100%; height:100%; font-size:14dp; }
div { display:block; box-sizing:border-box; }
#panel { position:absolute; left:0; right:0; top:0; bottom:0; border:2dp var(--ink); display:flex; flex-direction:column; }
button { display:block; box-sizing:border-box; height:32dp; line-height:32dp; padding:0 12dp; text-align:center; flex-shrink:0; }
button:focus { border:2dp var(--ink); }
#header, #header-actions, #identity, #controls, #compose-actions, #footer, #connection-actions, #approval-actions { display:flex; align-items:center; gap:8dp; flex-shrink:0; }
#header { padding:18dp 20dp 15dp; border-bottom:1dp var(--ink); }
#identity { gap:10dp; }
#mark { display:none; width:30dp; height:30dp; border:2dp var(--ink); text-align:center; line-height:28dp; font-size:15dp; font-weight:bold; }
#heading { font-size:15dp; font-weight:bold; letter-spacing:0.2dp; }
#state { font-size:11dp; margin-top:3dp; }
#header-actions { margin-left:auto; gap:6dp; }
#scope { border:2dp var(--ink); font-size:11dp; height:28dp; line-height:26dp; padding:0 10dp; }
#close { width:28dp; height:28dp; line-height:26dp; padding:0; font-size:20dp; }
#scope-note { display:none; }
#project { display:none; box-sizing:border-box; margin:12dp 18dp 0; width:90%; height:34dp; padding:8dp 10dp; border:2dp var(--ink); font-size:12dp; flex-shrink:0; }
#conversation { flex:1; min-height:0; width:100%; overflow-y:auto; padding:22dp 22dp 8dp; }
#empty { padding-top:65dp; }
#empty-kicker { font-size:11dp; letter-spacing:1.4dp; margin-bottom:14dp; }
#empty-title { font-size:24dp; font-weight:bold; line-height:32dp; max-width:300dp; margin-bottom:12dp; }
#empty-description { font-size:13dp; line-height:21dp; max-width:330dp; }
#transcript { line-height:23dp; word-break:break-word; }
.chat-message { margin-bottom:26dp; }
.chat-role { font-size:10dp; font-weight:bold; letter-spacing:0.8dp; margin-bottom:10dp; }
.chat-user { border:2dp var(--ink); padding:13dp 15dp; margin-left:0; }
.chat-user .chat-role { margin-bottom:5dp; }
.chat-user-text { white-space:pre-wrap; }
.md-paragraph { margin-bottom:12dp; }
.md-heading { font-weight:bold; margin-top:15dp; margin-bottom:10dp; line-height:26dp; }
.md-h1 { font-size:20dp; } .md-h2 { font-size:18dp; } .md-h3 { font-size:15dp; }
.md-strong { font-weight:bold; } .md-em { font-style:italic; }
.md-code { font-size:12dp; padding:2dp 4dp; }
.md-code-block { margin:12dp 0; border:2dp var(--ink); padding:12dp; }
.md-code-label { font-size:10dp; margin-bottom:8dp; }
.md-pre { font-size:12dp; line-height:19dp; white-space:pre-wrap; }
.md-list-row { display:flex; align-items:flex-start; gap:6dp; margin-bottom:7dp; }
.md-marker { display:block; width:20dp; flex-shrink:0; }
.md-list-body { flex:1; min-width:0; }
.md-quote { border-left:3dp var(--ink); padding-left:12dp; margin:10dp 0; }
.md-rule { border-top:1dp var(--ink); margin:16dp 0; }
.md-table { margin:12dp 0; border:2dp var(--ink); }
.md-table-row { display:flex; border-bottom:1dp var(--ink); }
.md-table-heading { font-weight:bold; }
.md-table-cell { flex:1; min-width:0; padding:7dp; font-size:12dp; }
#plan { display:none; white-space:pre-wrap; font-size:12dp; line-height:22dp; margin-top:12dp; }
#activity { display:none; font-size:12dp; line-height:19dp; margin:10dp 0; }
#request { display:none; border:2dp var(--ink); padding:14dp; margin:14dp 0; }
#question { white-space:pre-wrap; line-height:21dp; margin-bottom:10dp; }
#choices { display:flex; flex-direction:column; gap:6dp; }
.choice { display:none; width:100%; height:auto; min-height:34dp; line-height:20dp; padding:8dp 10dp; border:2dp var(--ink); text-align:left; white-space:normal; }
#approval-actions { margin-top:10dp; }
#controls { display:none; margin:0 18dp 10dp; gap:5dp; }
#pause, #stop, #undo { height:28dp; line-height:26dp; font-size:11dp; border:2dp var(--ink); }
#undo { margin-left:auto; }
#compose { margin:0 16dp; border:2dp var(--ink); flex-shrink:0; }
#message { display:block; box-sizing:border-box; width:100%; height:82dp; padding:16dp 15dp 8dp; font-size:14dp; line-height:22dp; }
#compose-actions { padding:8dp 10dp 10dp; border-top:1dp var(--ink); gap:7dp; }
#settings-open { font-size:11dp; height:30dp; line-height:30dp; padding:0 8dp; }
#talk { font-size:11dp; height:30dp; line-height:30dp; padding:0 8dp; }
#mic-status { display:none; }
#send { margin-left:auto; font-weight:bold; min-width:64dp; height:32dp; line-height:32dp; font-size:12dp; }
#footer { padding:10dp 20dp 12dp; font-size:10dp; }
#details { margin-left:auto; height:22dp; line-height:22dp; padding:0 7dp; font-size:10dp; }
#hint { font-size:10dp; }
#limits { display:none; font-size:10dp; line-height:18dp; margin-top:8dp; }
#connection-actions { display:none; margin:10dp 0; }
#login, #retry { border:2dp var(--ink); font-size:12dp; }
scrollbarvertical { width:4dp; margin-left:5dp; }
scrollbarvertical sliderbar { min-height:28dp; }
scrollbarvertical sliderarrowinc, scrollbarvertical sliderarrowdec { height:0; }
.small #header { padding:13dp 13dp 12dp; }
.small #mark { display:none; }
.small #heading { font-size:14dp; }
.small #conversation { padding:18dp 15dp 5dp; }
.small #compose { margin:0 10dp; }
.small #message { height:76dp; padding:13dp 12dp 7dp; font-size:13dp; }
.small #footer { padding:8dp 13dp 10dp; }
.small .chat-user { margin-left:12dp; padding:11dp; }
.small #empty { padding-top:40dp; }
.small #empty-title { font-size:22dp; line-height:29dp; }
.small #controls { margin-left:11dp; margin-right:11dp; }
</style><link type="text/rcss" href="../rmlui/theme.rcss"/></head><body class="shell assistant-panel" data-model="state"><div id="panel">
<div id="header"><div id="identity"><div id="mark">A</div><div><div id="heading">Assistant</div><div id="state">Ready</div></div></div><div class="title-rule"/><div id="header-actions"><button id="scope">Desktop</button><button id="close">×</button></div><div id="scope-note"/></div>
<input id="project" type="text" data-value="project" placeholder="Project directory"/>
<div id="conversation"><div id="empty"><div id="empty-kicker">ATAXIA</div><div id="empty-title">What would you like to do?</div><div id="empty-description">Arrange windows, work in a project, or build a small app.</div></div><div id="transcript" data-rml="transcript"/><div id="plan"/><div id="activity"/>
<div id="connection-actions"><button id="login">Sign in</button><button id="retry">Retry</button></div>
<div id="request"><div id="question"/><div id="choices"><button id="choice0" class="choice"/><button id="choice1" class="choice"/><button id="choice2" class="choice"/><button id="choice3" class="choice"/><button id="choice4" class="choice"/><button id="choice5" class="choice"/></div><div id="approval-actions"><button id="allow">Allow once</button><button id="deny">Deny</button></div></div><div id="limits"/></div>
<div id="controls"><button id="pause">Pause</button><button id="stop">Stop</button><button id="undo">Undo layout</button></div>
<div id="compose"><textarea id="message" data-value="message" autofocus="autofocus" placeholder="Ask anything about your workspace…"/>
<div id="compose-actions"><button id="settings-open">Model settings</button><button id="talk">Voice</button><div id="mic-status">Microphone off</div><button id="send">Send</button></div></div>
<div id="footer"><div id="hint">Esc close · Ctrl+Alt+Esc pause all</div><button id="details">Details</button></div>
</div></body></rml>
