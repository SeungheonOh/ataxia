import { Workstation } from "theme.slint";
export component MetaButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <bool> quiet-danger: false;
    in property <bool> align-left: false;
    callback activate();
    min-width: 30px;
    preferred-height: 30px;
    border-width: 2px;
    border-color: Workstation.ink;
    border-radius: 0px;
    background: touch.pressed ? #444440 : root.selected || touch.has-hover || focus.has-focus ? Workstation.ink : Workstation.paper;
    opacity: root.enabled ? 1 : 0.55;
    accessible-role: button;
    accessible-label: root.label;
    forward-focus: focus;
    Text {
        x: root.align-left ? 10px : 0px;
        width: parent.width - (root.align-left ? 20px : 0px);
        text: root.label;
        color: root.selected || touch.has-hover || focus.has-focus ? Workstation.paper : root.quiet-danger ? Workstation.danger : Workstation.ink;
        font-family: "DejaVu Sans Mono";
        font-size: 12px;
        horizontal-alignment: root.align-left ? left : center;
        vertical-alignment: center;
        overflow: elide;
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.activate();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { focus.focus(); root.activate(); }
    }
}
