<rml><head><title>Screen sharing</title><style>
body { margin:0; width:100%; height:100%; font-size:12dp; }
div { display:block; box-sizing:border-box; } input { box-sizing:border-box; }
#bar { position:absolute; left:0; top:0; right:0; bottom:0; padding:9dp; border:2dp var(--ink); display:flex; gap:12dp; align-items:center; }
#label { flex-grow:1; white-space:nowrap; } .action { flex-shrink:0; width:105dp; height:28dp; padding:5dp 10dp; }
</style><link type="text/rcss" href="../rmlui/theme.rcss"/></head><body class="shell screencast-indicator"><div id="bar"><div id="label">Screen sharing is active</div><input class="action" type="button" id="stop" value="Stop sharing"/></div></body></rml>
