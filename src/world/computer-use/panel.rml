<rml><head><title>Agent sessions</title><style>
body { margin:0; width:100%; height:100%; font-size:13dp; }
div { display:block; box-sizing:border-box; }
button, input.button, input.action { display:block; box-sizing:border-box; height:var(--control); line-height:var(--control-line); padding:0 var(--gap); flex-shrink:0; }
body { font-size:12dp; }
#panel { position:absolute; left:0; top:0; overflow-y:auto; border:var(--frame) var(--ink); }
#content { padding:var(--inset); }
#header { display:flex; align-items:center; gap:var(--gap); height:var(--control); }
#heading { font-weight:bold; font-size:var(--heading); white-space:nowrap; }
#pause-all { margin-left:auto; font-size:11dp; }
#empty { margin-top:var(--section); }
.card { display:none; margin-top:var(--section); }
.title { display:flex; align-items:center; gap:var(--gap); }
.dot { width:8dp; height:8dp; }
.name { flex:1; min-width:0; font-weight:bold; font-size:13dp; overflow:hidden; white-space:nowrap; }
.state { margin-left:auto; flex-shrink:0; font-size:11dp; }
.detail { min-height:16dp; margin-top:var(--gap); }
.scope { font-size:11dp; margin-top:var(--unit); }
.actions { display:flex; gap:var(--gap); margin-top:var(--gap); }
.actions button { font-size:12dp; }
#hint { font-size:11dp; margin-top:var(--section); }
</style><link type="text/rcss" href="../rmlui/theme.rcss"/></head><body class="shell computer-use-panel"><div id="panel"><div id="content">
<div id="header"><div id="heading">Agent sessions</div><button id="pause-all">Pause all</button></div>
<div id="empty">Agents appear here when they connect.</div>
<div id="card0" class="card"><div class="title"><div id="dot0" class="dot"/><div id="name0" class="name">Agent</div><div id="state0" class="state">ACTIVE</div></div><div id="detail0" class="detail"/><div id="scope0" class="scope"/><div class="actions"><button id="resume0" class="resume">Resume</button><button id="pause0">Pause</button><button id="stop0" class="stop">Disconnect</button></div></div>
<div id="card1" class="card"><div class="title"><div id="dot1" class="dot"/><div id="name1" class="name">Agent</div><div id="state1" class="state">ACTIVE</div></div><div id="detail1" class="detail"/><div id="scope1" class="scope"/><div class="actions"><button id="resume1" class="resume">Resume</button><button id="pause1">Pause</button><button id="stop1" class="stop">Disconnect</button></div></div>
<div id="card2" class="card"><div class="title"><div id="dot2" class="dot"/><div id="name2" class="name">Agent</div><div id="state2" class="state">ACTIVE</div></div><div id="detail2" class="detail"/><div id="scope2" class="scope"/><div class="actions"><button id="resume2" class="resume">Resume</button><button id="pause2">Pause</button><button id="stop2" class="stop">Disconnect</button></div></div>
<div id="card3" class="card"><div class="title"><div id="dot3" class="dot"/><div id="name3" class="name">Agent</div><div id="state3" class="state">ACTIVE</div></div><div id="detail3" class="detail"/><div id="scope3" class="scope"/><div class="actions"><button id="resume3" class="resume">Resume</button><button id="pause3">Pause</button><button id="stop3" class="stop">Disconnect</button></div></div>
<div id="hint">Ctrl + Alt + Esc pauses every agent.</div>
</div></div></body></rml>
