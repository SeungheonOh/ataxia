<rml>
<head>
<title>Notepad</title>
<style>
body {
    margin: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    color: #24282d;
    font-family: DejaVu Sans;
    font-size: 15px;
}
#header {
    flex-shrink: 0;
    padding: 18px 20px 14px;
    border-bottom: 1px #e4e7eb;
}
#header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
}
#title { display: block; font-size: 20px; line-height: 28px; }
#subtitle { display: block; margin-top: 3px; font-size: 12px; color: #68717b; }
#close {
    flex-shrink: 0;
    padding: 7px 14px;
    border: 1px #c8cdd3;
    border-radius: 4px;
    background: #ffffff;
    color: #343a40;
    font-size: 13px;
}
#close:hover { background: #f3f5f7; }
#close:focus { border-color: #477ad1; }
#editor {
    display: block;
    flex: 1;
    min-height: 0;
    box-sizing: border-box;
    margin: 16px;
    padding: 12px;
    border: 1px #d4d8dc;
    background: #ffffff;
    color: #24282d;
    font-family: DejaVu Sans;
    font-size: 16px;
    line-height: 25px;
    overflow-y: auto;
}
#editor:focus { border-color: #477ad1; }
#footer {
    flex-shrink: 0;
    padding: 0 20px 14px;
    font-size: 11px;
    line-height: 17px;
    color: #68717b;
}
</style>
</head>
<body>
<div id="header"><div id="header-row"><div id="title">Notepad</div><button id="close">Close</button></div><div id="subtitle">Write a quick note.</div></div>
<textarea id="editor" autofocus="autofocus" placeholder="Start writing…"></textarea>
<div id="footer">Temporary notes. Closing or reloading this preview clears the text.</div>
</body>
</rml>
