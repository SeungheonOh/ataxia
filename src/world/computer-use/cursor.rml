<rml><head><title>Agent cursor</title><style>
body { --accent:#365dc0; margin:0; width:100%; height:100%; font-family:DejaVu Sans; color:#24282d; font-size:11dp; }
div { display:block; }
#tag { position:absolute; left:0; top:0; right:0; bottom:0; padding:6dp 8dp; background:#ffffff; border:1dp #d4d8dc; border-left:3dp var(--accent); }
#name { color:#24282d; font-weight:bold; font-size:11dp; }
#state { color:#626a73; font-size:10dp; margin-top:3dp; }
#tag.clicked { animation:0.25s linear 1 click; }
@keyframes click { from { background:#eaf0ff; } to { background:#ffffff; } }
</style></head><body><div id="tag"><div id="name">Agent</div><div id="state">Connected</div></div></body></rml>
