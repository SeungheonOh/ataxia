import { MetaButton } from "controls.slint";

export component ObjectControls inherits Window {
    background: transparent;
    in property <bool> owned: false;
    in property <bool> detachable: false;
    in property <bool> niri: false;
    in property <bool> floating: false;
    callback action(string);
    Rectangle { border-width: 1px; border-color: #c7c7c7; border-radius: 7px; background: #ffffff; }
    HorizontalLayout {
        padding: 3px; spacing: 3px;
        if root.detachable : MetaButton { label: "Detach"; activate => { root.action("pull-out"); } }
        if root.owned : MetaButton { label: root.floating ? "Tile" : "Float"; activate => { root.action("floating"); } }
        if root.owned : MetaButton { label: "Full"; activate => { root.action("fullscreen"); } }
        if root.niri : MetaButton { label: "Stack"; activate => { root.action("consume"); } }
        if root.niri : MetaButton { label: "Split"; activate => { root.action("expel"); } }
        MetaButton { width: 28px; label: "×"; activate => { root.action("close"); } }
    }
}
