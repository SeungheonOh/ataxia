<rml><head><title>Ataxia status bar</title><style>
body { margin:0; width:100%; height:100%; font-family:DejaVu Sans; font-size:12dp; color:#24282d; }
div { display:block; box-sizing:border-box; }
#bar { position:absolute; left:0; right:0; top:0; height:44dp; box-sizing:border-box;
 display:flex; align-items:center; gap:10dp; padding:5dp 12dp 6dp; background:#ffffff; border-top:1dp #d4d8dc; }
button { display:block; box-sizing:border-box; height:32dp; line-height:32dp; padding:0 10dp;
 color:#424950; background:transparent; text-align:center; }
button:hover { background:#f0f2f4; color:#24282d; }
button:active { background:#e3e7eb; }
#home { flex-shrink:0; font-weight:bold; }
#mark { display:none; }
#brand { line-height:32dp; }
.separator { width:1dp; height:20dp; background:#d4d8dc; flex-shrink:0; }
#context { display:flex; align-items:center; min-width:60dp; flex-shrink:1; }
#group { max-width:285dp; overflow:hidden; white-space:nowrap; color:#244ebc; background:#f1f5ff; }
.arrow { display:none; }
#workspaces { display:none; }
.workspace { width:30dp; height:32dp; line-height:32dp; padding:0; color:#626a73; }
.workspace.selected { color:#244ebc; background:#eaf0ff; font-weight:bold; }
#selection, #focus-label, #apps, #power-note { display:none; }
#focus { flex:1; min-width:0; overflow:hidden; white-space:nowrap; }
#title { line-height:32dp; color:#626a73; overflow:hidden; white-space:nowrap; }
#right { display:flex; align-items:center; gap:6dp; margin-left:auto; flex-shrink:0; }
#audio, #clipboard { padding:0 7dp; }
#media { display:none; max-width:180dp; overflow:hidden; white-space:nowrap; padding:0 8dp; color:#35664f; }
#power { padding:0 6dp; display:flex; align-items:center; gap:8dp; white-space:nowrap; }
#battery { position:relative; width:22dp; height:12dp; padding:2dp; border:1dp #626a73; }
#charge { height:100%; width:75%; background:#626a73; }
#battery-tip { position:absolute; right:-4dp; top:3dp; width:2dp; height:4dp; background:#626a73; }
#power-copy { line-height:32dp; }
#power-symbol { color:#35664f; font-size:14dp; line-height:32dp; }
#bar.low #charge { background:#9a651b; }
#bar.low #power { color:#9a651b; }
#bar.critical #charge { background:#ad343f; }
#bar.critical #power { color:#ad343f; }
#clock { line-height:32dp; color:#24282d; white-space:nowrap; }
#date { color:#626a73; white-space:nowrap; }
#bar.has-media #media { display:block; }
#bar.compact { gap:8dp; }
.compact #focus, .compact #date, #bar.compact #media { display:none; }
#bar.narrow { gap:8dp; padding-left:8dp; padding-right:8dp; }
.narrow #power-text, .narrow .separator { display:none; }
.narrow #group { max-width:220dp; padding:0 7dp; }
#bar.tiny { gap:4dp; padding-left:4dp; padding-right:4dp; }
#bar.tiny #group { max-width:90dp; font-size:11dp; }
#bar.tiny #right { gap:2dp; }
#bar.tiny #home { padding:0 6dp; }
#assistant { display:none; height:28dp; line-height:28dp; padding:0 8dp; font-size:11dp; background:#eaf0ff; color:#244ebc; }
#bar.tiny #apps, #bar.tiny #clock, #bar.tiny #clipboard { display:none; }
#bar.tiny #audio { max-width:38dp; overflow:hidden; white-space:nowrap; font-size:11dp; }
</style></head><body>
<div id="bar">
 <button id="home"><div id="mark">a</div><div id="brand">Apps</div></button>
 <div class="separator"/>
 <div id="context"><button id="previous" class="arrow">‹</button><button id="group">Overview / Workspaces ▾</button><button id="next" class="arrow">›</button></div>
 <div id="workspaces"><div id="selection"/>
 <button id="ws1" class="workspace selected">1</button><button id="ws2" class="workspace">2</button><button id="ws3" class="workspace">3</button>
 <button id="ws4" class="workspace">4</button><button id="ws5" class="workspace">5</button><button id="ws6" class="workspace">6</button>
 <button id="ws7" class="workspace">7</button><button id="ws8" class="workspace">8</button><button id="ws9" class="workspace">9</button></div>
 <div id="focus"><div id="focus-label">IN FOCUS</div><div id="title">Desktop</div></div>
 <div id="right"><button id="assistant">Assistant</button><div id="apps">0 apps</div>
 <button id="media">Media</button><button id="audio">♪</button><button id="clipboard">▤</button>
 <button id="power"><div id="battery"><div id="charge"/><div id="battery-tip"/></div><div id="power-symbol">↯</div><div id="power-copy"><div id="power-text">AC</div><div id="power-note">Plugged in</div></div></button>
 <div class="separator"/><div id="date">THU, SEP 10</div><div id="clock">12:00</div></div>
</div></body></rml>
