import { Workstation } from "theme.slint";
export component MetaButton inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <bool> quiet-danger: false;
    in property <bool> align-left: false;
    callback activate();
    min-width: 8px;
    preferred-height: 16px;
    private property <bool> inverted: root.enabled && (root.selected || touch.has-hover || focus.has-focus || touch.pressed);
    background: root.inverted ? (root.quiet-danger ? Workstation.danger : Workstation.ink) : transparent;
    opacity: root.enabled ? 1 : 0.55;
    accessible-role: button;
    accessible-label: root.label;
    forward-focus: focus;
    Text {
        x: 0px;
        width: max(0px, parent.width);
        text: root.label;
        color: root.inverted ? Workstation.paper : root.quiet-danger ? Workstation.danger : Workstation.ink;
        font-family: "DejaVu Sans Mono";
        font-size: 12px;
        horizontal-alignment: root.align-left ? left : center;
        vertical-alignment: center;
        overflow: elide;
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.activate();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { focus.focus(); root.activate(); }
    }
}
