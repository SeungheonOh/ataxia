<rml>
<head>
  <title>Ataxia native CSS panel</title>
  <style>
    div, h1 { display: block; }
    body {
      --accent: #85e6bd;
      margin: 0; width: 100%; height: 100%;
      font-family: DejaVu Sans; font-size: 14dp; color: #eaf4f0;
    }
    .panel {
      position: absolute; left: 16dp; top: 16dp; right: 16dp; bottom: 16dp;
      padding: 24dp; border-radius: 18dp; background: #152522;
      border: 1dp #38534a; box-shadow: #0007 0dp 6dp 12dp 2dp;
    }
    .eyebrow { position:absolute; top:24dp; left:24dp; color: var(--accent); font-size: 11dp; letter-spacing: 2dp; margin-bottom: 14dp; }
    h1 { margin: 24dp 0 8dp; font-size: 28dp; font-weight: bold; }
    .subtitle { color: #a4bcb3; margin-bottom: 22dp; }
    .row { display: flex; gap: 12dp; margin-bottom: 20dp; }
    .card { flex: 1; padding: 14dp; border-radius: 10dp; background: #223a32; }
    .label { color: #a4bcb3; font-size: 11dp; margin-bottom: 6dp; }
    .value { font-size: 19dp; color: var(--accent); }
    .track { height: 5dp; border-radius: 3dp; background: #304a41; margin-bottom: 20dp; }
    .fill { width: 72%; height: 100%; border-radius: 3dp; decorator: linear-gradient(90deg, #4582e8, #85e6bd); }
    .actions { display: flex; gap: 10dp; }
    button {
      padding: 10dp 14dp; border-radius: 8dp; background: var(--accent); color: #132820;
      transition: transform 0.16s, opacity 0.16s;
    }
    button:hover { opacity: 0.8; transform: translateY(-2dp); }
    button:active { transform: translateY(0dp); }
    #close { background: #304a41; color: #eaf4f0; }
    #status { margin-top: 16dp; color: #a4bcb3; font-size: 11dp; }
    .pulse { animation: 0.5s ease-in-out 1 pulse; }
    @keyframes pulse { from { opacity: 0.35; } to { opacity: 1; } }
  </style>
</head>
<body>
  <div class="panel">
    <div class="eyebrow">ATAXIA / NATIVE UI</div>
    <h1>A little more expressive.</h1>
    <div class="subtitle">CSS layout. Lisp behavior. One shared World.</div>
    <div class="row">
      <div class="card"><div class="label">THIS PANEL</div><div class="value">RmlUi</div></div>
      <div class="card"><div class="label">EXISTING UI</div><div class="value">Slint</div></div>
    </div>
    <div class="track"><div class="fill" /></div>
    <div class="actions"><button id="theme">Change accent</button><button id="animate">Animate</button><button id="close">Close</button></div>
    <div id="status">Ready. Updates sleep when the panel is still.</div>
  </div>
</body>
</rml>
