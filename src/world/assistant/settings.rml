<rml><head><title>Model settings</title><style>
body { margin:0; width:100%; height:100%; font-size:13dp; }
div { display:block; box-sizing:border-box; }
#settings-layer { position:absolute; left:0; right:0; top:0; bottom:0; display:flex; align-items:center; justify-content:center; }
#settings-backdrop { position:absolute; left:0; right:0; top:0; bottom:0; }
#dialog { position:relative; z-index:1; width:420dp; max-width:94%; padding:0; border:var(--frame) var(--ink); }
#dialog-header, #speed-row, #dialog-actions { display:flex; align-items:center; gap:0 var(--gap); }
#dialog-heading { font-size:var(--heading); font-weight:bold; }
#settings-close { margin-left:auto; width:var(--control); padding:0; text-align:center; font-size:14dp; }
#dialog-description { margin:0; font-size:12dp; line-height:16dp; }
.setting { margin-bottom:0; }
.setting-label { font-size:12dp; font-weight:bold; margin-bottom:0; }
#model-field, #effort-field { position:relative; width:100%; height:var(--field-height); }
select { display:block; width:100%; height:var(--field-height); box-sizing:border-box; border:var(--frame) var(--ink); font-size:13dp; }
select selectvalue { padding:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
select selectarrow { width:var(--control); }
#model-chevron, #effort-chevron { position:absolute; top:0; right:var(--gap); pointer-events:none; }
select selectbox { border:var(--frame) var(--ink); max-height:248dp; overflow-y:auto; z-index:20; }
select option { display:block; padding:0; }
#models-load { margin-top:0; font-size:12dp; }
#speed-copy { flex:1; min-width:0; }
#speed-label { font-size:12dp; font-weight:bold; margin-bottom:0; }
#speed-description { font-size:11dp; line-height:16dp; }
#fast { flex-shrink:0; min-width:0; font-size:11dp; }
#model-note { display:none; margin-top:0; font-size:11dp; line-height:16dp; }
#dialog-actions { flex-wrap:wrap; margin-top:0; }
#saved-note { flex:1; min-width:0; font-size:11dp; }
#settings-done { margin-left:auto; }
</style><link type="text/rcss" href="../rmlui/theme.rcss"/></head><body class="shell assistant-settings" data-model="state"><div id="settings-layer">
<div id="settings-backdrop"/>
<div id="dialog"><div id="dialog-header"><div id="dialog-heading">Model settings</div><button id="settings-close">×</button></div>
<div id="dialog-description">Choose how the assistant handles your next task.</div>
<div id="model-setting" class="setting"><div class="setting-label">Model</div><div id="model-field" data-rml="model_options"><select id="model-select" data-value="selected_model"><option value="">Codex default</option></select><div id="model-chevron">▾</div></div><button id="models-load">Connect</button></div>
<div id="effort-setting" class="setting"><div class="setting-label">Reasoning effort</div><div id="effort-field" data-rml="effort_options"><select id="effort-select" data-value="selected_effort"><option value="">Auto</option></select><div id="effort-chevron">▾</div></div></div>
<div id="speed-row"><div id="speed-copy"><div id="speed-label">Fast mode</div><div id="speed-description">Faster responses, independent of effort.</div></div><button id="fast">Fast off</button></div>
<div id="model-note"/>
<div id="dialog-actions"><div id="saved-note">Changes save automatically</div><button id="settings-done" autofocus="autofocus">Done</button></div>
</div></div></body></rml>
