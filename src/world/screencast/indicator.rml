<rml><head><title>Screen sharing</title><style>
body { margin:0; width:100%; height:100%; font-family:DejaVu Sans; font-size:12dp; color:#24282d; }
div { display:block; box-sizing:border-box; } input { box-sizing:border-box; }
#bar { position:absolute; left:0; top:0; right:0; bottom:0; padding:9dp; border:1dp #d4d8dc; background:#ffffff; display:flex; gap:12dp; align-items:center; }
#label { flex-grow:1; white-space:nowrap; } .action { flex-shrink:0; width:105dp; height:28dp; background:#f1f5ff; color:#244ebc; padding:5dp 10dp; } .action:hover { background:#e3ebff; }
</style></head><body><div id="bar"><div id="label">Screen sharing is active</div><input class="action" type="button" id="stop" value="Stop sharing"/></div></body></rml>
