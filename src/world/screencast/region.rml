<rml><head><title>Select canvas region</title><style>
body { margin:0; width:100%; height:100%; font-size:13dp; }
div { display:block; box-sizing:border-box; }
#instruction { position:absolute; left:var(--inset); right:var(--inset); top:0; padding:0 var(--inset); text-align:center; border:var(--frame) var(--ink); font-size:12dp; }
#rectangle { position:absolute; display:none; }
</style><link type="text/rcss" href="../rmlui/theme.rcss"/></head><body class="shell screencast-region"><div id="rectangle"/><div id="instruction">Drag to select a canvas region · Escape to cancel</div></body></rml>
