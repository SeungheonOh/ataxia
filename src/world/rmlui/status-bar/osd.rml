<rml><head><title>System control</title><style>
body { margin:0; width:100%; height:100%; font-size:13dp; }
div { display:block; box-sizing:border-box; }
#panel { width:100%; height:100%; border:2dp var(--ink); padding:16dp 20dp; }
#heading { display:flex; align-items:center; gap:12dp; height:28dp; }
#icon { font-size:24dp; width:28dp; }
#label { flex:1; font-weight:bold; white-space:nowrap; overflow:hidden; }
#value { font-size:18dp; font-weight:bold; }
#track { height:5dp; margin:10dp 0; }
#fill { height:100%; width:50%; }
#detail { height:18dp; font-size:11dp; white-space:nowrap; overflow:hidden; }
.media #track { display:none; }
.media #detail { margin-top:12dp; }
</style><link type="text/rcss" href="../theme.rcss"/></head><body class="shell shell-osd"><div id="panel"><div id="heading"><div id="icon">☀</div><div id="label">Brightness</div><div id="value">50%</div></div><div id="track"><div id="fill"/></div><div id="detail">Display backlight</div></div></body></rml>
