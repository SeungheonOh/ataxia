<rml><head><title>Screen sharing</title><style>
body { margin:0; width:100%; height:100%; font-size:13dp; }
div { display:block; box-sizing:border-box; }
button, input.button, input.action { display:block; box-sizing:border-box; height:var(--control); line-height:var(--control-line); padding:0 var(--gap); flex-shrink:0; }
#bar { width:100%; height:100%; padding:var(--gap) var(--inset); border:var(--frame) var(--ink); display:flex; gap:var(--gap); align-items:center; }
#label { flex:1; min-width:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font-size:12dp; }
#stop { width:116dp; font-size:11dp; }
</style><link type="text/rcss" href="../rmlui/theme.rcss"/></head><body class="shell screencast-indicator"><div id="bar"><div id="label">Screen sharing is active</div><input class="action" type="button" id="stop" value="Stop sharing"/></div></body></rml>
