<rml><head><title>Ataxia status bar</title><style>
body { margin:0; width:100%; height:100%; font-size:12dp; }
div { display:block; box-sizing:border-box; }
#bar { position:absolute; left:0; right:0; top:0; height:18dp; box-sizing:border-box;
 display:flex; align-items:center; gap:0 var(--gap); padding:0 var(--inset); border-top:1dp var(--ink); }
button { height:var(--control); }
#home { flex-shrink:0; font-weight:bold; }
#mark { display:none; }
#brand { line-height:var(--control-line); }
#context { display:flex; align-items:center; min-width:0; flex:0 1 240dp; overflow:hidden; }
#group { width:100%; min-width:0; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.arrow { display:none; }
#workspaces { display:none; }
.workspace { width:30dp; height:var(--control); line-height:var(--control-line); padding:0; }
.workspace.selected { font-weight:bold; }
#selection, #focus-label, #apps, #power-note { display:none; }
#focus { flex:1; min-width:0; overflow:hidden; white-space:nowrap; }
#title { line-height:var(--control-line); overflow:hidden; white-space:nowrap; }
#right { display:flex; align-items:center; gap:0 var(--gap); margin-left:auto; flex-shrink:0; }
#audio, #clipboard { padding:0; }
#media { display:none; max-width:180dp; overflow:hidden; white-space:nowrap; padding:0; }
#power { padding:0; display:flex; align-items:center; gap:0 var(--gap); white-space:nowrap; }
#battery { position:relative; width:22dp; height:12dp; padding:0; border:1dp var(--ink); }
#charge { height:100%; width:75%; }
#battery-tip { position:absolute; right:-4dp; top:3dp; width:2dp; height:4dp; }
#power-copy { line-height:var(--control-line); }
#power-symbol { font-size:14dp; line-height:var(--control-line); }
#clock { line-height:var(--control-line); white-space:nowrap; }
#date { white-space:nowrap; }
#bar.has-media #media { display:block; }
#bar.compact { gap:0 var(--gap); }
.compact #focus, .compact #date, #bar.compact #media { display:none; }
#bar.narrow { gap:0 var(--gap); }
.narrow #power-text { display:none; }
.narrow #context { flex-basis:220dp; }
#bar.tiny { gap:0 var(--gap); }
#bar.tiny #context { flex-basis:72dp; }
#bar.tiny #group { font-size:11dp; }
#bar.tiny #right { gap:0 var(--gap); }
#bar.tiny #assistant { padding:0; font-size:10dp; }
#bar.tiny #home { padding:0; }
#bar.tiny #assistant { max-width:64dp; overflow:hidden; text-overflow:ellipsis; }
#assistant { display:none; font-size:11dp; }
#bar.tiny #apps, #bar.tiny #clock, #bar.tiny #clipboard { display:none; }
#bar.tiny #audio { max-width:38dp; overflow:hidden; white-space:nowrap; font-size:11dp; }
</style><link type="text/rcss" href="../theme.rcss"/></head><body class="shell shell-bar">
<div id="bar">
 <button id="home"><div id="mark">a</div><div id="brand">Apps</div></button>

 <div id="context"><button id="previous" class="arrow">‹</button><button id="group">Overview / Workspaces ▾</button><button id="next" class="arrow">›</button></div>
 <div id="workspaces"><div id="selection"/>
 <button id="ws1" class="workspace selected">1</button><button id="ws2" class="workspace">2</button><button id="ws3" class="workspace">3</button>
 <button id="ws4" class="workspace">4</button><button id="ws5" class="workspace">5</button><button id="ws6" class="workspace">6</button>
 <button id="ws7" class="workspace">7</button><button id="ws8" class="workspace">8</button><button id="ws9" class="workspace">9</button></div>
 <div id="focus"><div id="focus-label">IN FOCUS</div><div id="title">Desktop</div></div>
 <div id="right"><button id="assistant">Assistant</button><div id="apps">0 apps</div>
 <button id="media">Media</button><button id="audio">♪</button><button id="clipboard">▤</button>
 <button id="power"><div id="battery"><div id="charge"/><div id="battery-tip"/></div><div id="power-symbol">↯</div><div id="power-copy"><div id="power-text">AC</div><div id="power-note">Plugged in</div></div></button>
 <div id="date">THU, SEP 10</div><div id="clock">12:00</div></div>
</div></body></rml>
