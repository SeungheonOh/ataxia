<rml><head><title>System control</title><style>
body { margin:0; width:100%; height:100%; font-family:DejaVu Sans; color:#24282d; font-size:13dp; }
div { display:block; box-sizing:border-box; }
#panel { width:100%; height:100%; background:#fff; border:1dp #c9ced4; padding:16dp 20dp; }
#heading { display:flex; align-items:center; gap:12dp; height:28dp; }
#icon { font-size:24dp; width:28dp; }
#label { flex:1; font-weight:bold; white-space:nowrap; overflow:hidden; }
#value { font-size:18dp; font-weight:bold; }
#track { height:5dp; background:#e5e9ee; margin:10dp 0; }
#fill { height:100%; background:#355fd0; width:50%; }
#detail { height:18dp; color:#626a73; font-size:11dp; white-space:nowrap; overflow:hidden; }
.muted #fill { background:#89929e; }
.error #detail { color:#ac3543; }
.media #track { display:none; }
.media #detail { margin-top:12dp; }
</style></head><body><div id="panel"><div id="heading"><div id="icon">☀</div><div id="label">Brightness</div><div id="value">50%</div></div><div id="track"><div id="fill"/></div><div id="detail">Display backlight</div></div></body></rml>
