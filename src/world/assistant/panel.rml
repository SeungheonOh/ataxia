<rml><head><title>Ataxia assistant</title><style>
body { margin:0; width:100%; height:100%; font-size:14dp; }
div { display:block; box-sizing:border-box; }
#panel { width:100%; height:100%; padding:0 var(--inset); border:var(--frame) var(--ink); display:flex; flex-direction:column; }
#header, #header-actions, #identity, #controls, #compose-actions, #footer, #connection-actions, #approval-actions { display:flex; flex-wrap:wrap; align-items:center; gap:0 var(--gap); flex-shrink:0; }
#header { padding:0; }
#heading { font-size:var(--heading); font-weight:bold; }
#state { font-size:11dp; margin-top:0; }
#header-actions { margin-left:auto; min-width:0; }
#identity { min-width:0; }
#heading { white-space:nowrap; }
#scope { flex-shrink:1; min-width:0; font-size:11dp; max-width:120dp; overflow:hidden; text-overflow:ellipsis; }
#close { padding:0; font-size:12dp; }
#scope-note { display:none; }
#project { display:none; box-sizing:border-box; margin:0; width:100%; height:var(--field-height); padding:0 var(--inset); border:var(--frame) var(--ink); font-size:12dp; flex-shrink:0; }
#conversation { flex:1; min-height:0; width:100%; overflow-y:auto; padding:0; }
#transcript { line-height:16dp; word-break:break-word; }
.chat-message { margin-bottom:0; }
.chat-role { font-size:11dp; font-weight:bold; margin-bottom:0; }
.chat-user-text { white-space:pre-wrap; }
.md-paragraph { margin-bottom:0; }
.md-heading { font-weight:bold; margin-top:0; margin-bottom:0; line-height:16dp; }
.md-h1 { font-size:14dp; } .md-h2 { font-size:16dp; } .md-h3 { font-size:14dp; }
.md-strong { font-weight:bold; } .md-em { font-style:italic; }
.md-code { font-size:12dp; padding:0; }
.md-code-block { margin:0; padding:0 var(--inset); }
.md-code-label { font-size:11dp; margin-bottom:0; }
.md-pre { font-size:12dp; line-height:16dp; white-space:pre-wrap; }
.md-list-row { display:flex; align-items:flex-start; gap:0 var(--gap); margin-bottom:0; }
.md-marker { display:block; width:16dp; flex-shrink:0; }
.md-list-body { flex:1; min-width:0; }
.md-quote { border-left:var(--frame) var(--ink); padding:0 var(--inset); margin:0; }
.md-rule { border-top:var(--frame) var(--ink); margin:0; }
.md-table { margin:0; border:var(--frame) var(--ink); }
.md-table-row { display:flex; border-bottom:var(--frame) var(--ink); }
.md-table-heading { font-weight:bold; }
.md-table-cell { flex:1; min-width:0; padding:0 var(--inset); font-size:12dp; }
#plan { display:none; white-space:pre-wrap; font-size:12dp; line-height:16dp; margin-top:0; }
#activity { display:none; font-size:12dp; line-height:16dp; margin:0; }
#request { display:none; border:var(--frame) var(--ink); padding:0 var(--inset); margin:0; }
#question { white-space:pre-wrap; line-height:16dp; margin-bottom:0; }
#choices { display:flex; flex-direction:column; gap:0; }
.choice { display:none; width:100%; height:auto; min-height:var(--control); line-height:16dp; padding:0; text-align:left; white-space:normal; }
#approval-actions { margin-top:0; }
#controls { display:none; flex-wrap:wrap; margin:0; }
#pause, #stop, #undo { font-size:11dp; }
#undo { margin-left:auto; }
#compose { margin:0; flex-shrink:0; }
#message { display:block; box-sizing:border-box; width:100%; height:80dp; padding:0 var(--inset); border:var(--frame) var(--ink); font-size:14dp; line-height:16dp; }
#compose-actions { flex-wrap:wrap; padding:0; }
#settings-open, #fast-toggle, #talk, #mic-mute { font-size:11dp; }
#settings-open { max-width:200dp; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
#voice-controls { display:none; align-items:center; gap:0 var(--gap); flex-wrap:wrap; }
#mic-status { font-size:11dp; }
#voice-caption { display:none; max-height:48dp; overflow-y:auto; font-size:12dp; white-space:pre-wrap; word-break:break-word; }
#fast-toggle.enabled { background:var(--ink); color:var(--paper); }
#send { margin-left:auto; font-size:12dp; }
#footer { flex-wrap:wrap; padding:0; font-size:10dp; }
#details { margin-left:auto; font-size:10dp; }
#hint { flex:1; min-width:0; font-size:10dp; }
#limits { display:none; font-size:10dp; line-height:16dp; margin-top:0; }
#connection-actions { display:none; margin:0; }
#login, #retry { font-size:12dp; }
.small #scope { max-width:72dp; }
.small #hint { max-width:180dp; white-space:normal; }
</style><link type="text/rcss" href="../rmlui/theme.rcss"/></head><body class="shell assistant-panel" data-model="state"><div id="panel">
<div id="header"><div id="identity"><div><div id="heading">Assistant</div><div id="state">Ready</div></div></div><div id="header-actions"><button id="scope">Desktop</button><button id="close">Close</button></div><div id="scope-note"/></div>
<input id="project" type="text" data-value="project" placeholder="Project directory"/>
<div id="conversation"><div id="transcript" data-rml="transcript"/><div id="plan"/><div id="activity"/>
<div id="connection-actions"><button id="login">Sign in</button><button id="retry">Retry</button></div>
<div id="request"><div id="question"/><div id="choices"><button id="choice0" class="choice"/><button id="choice1" class="choice"/><button id="choice2" class="choice"/><button id="choice3" class="choice"/><button id="choice4" class="choice"/><button id="choice5" class="choice"/></div><div id="approval-actions"><button id="allow">Allow once</button><button id="deny">Deny</button></div></div><div id="limits"/></div>
<div id="controls"><button id="pause">Pause</button><button id="stop">Stop</button><button id="undo">Undo layout</button></div>
<div id="compose"><div id="voice-controls"><div id="mic-status">Microphone off</div><button id="mic-mute">Mute mic</button></div><div id="voice-caption"/>
<textarea id="message" data-value="message" autofocus="autofocus" placeholder="Describe a task…"/>
<div id="compose-actions"><button id="settings-open">Model settings</button><button id="fast-toggle" data-attrif-disabled="fast_disabled">Fast off</button><button id="talk">Voice</button><button id="send">Send</button></div></div>
<div id="footer"><div id="hint">Ctrl+Enter send · Esc close</div><button id="details">Details</button></div>
</div></body></rml>
