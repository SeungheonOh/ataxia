export component SubworldHeader inherits Window {
    background: transparent;
    in property <string> caption;
    in property <bool> active: false;
    callback enter();
    Rectangle {
        background: transparent;
        Rectangle {
            x: 3px; y: root.active ? 3px : 27px;
            width: root.active ? 24px : parent.width - 6px; height: root.active ? 24px : 1px; border-radius: 6px;
            background: transparent;
            border-width: focus.has-focus ? 1px : 0px; border-color: #8da1bd;
        }
        accessible-role: button;
        accessible-label: root.active ? "Back to Metaworld" : "Enter " + root.caption;
        forward-focus: focus;
        if root.active : Image { x: 7px; y: 7px; width: 16px; height: 16px; source: @image-url("icons/back.svg"); }
        Text {
            x: root.active ? 30px : 4px;
            width: max(0px, parent.width - self.x - 8px);
            text: root.caption; color: touch.has-hover ? #43536a : #657183;
            animate color { duration: 120ms; easing: cubic-bezier(0.2, 0, 0.2, 1); }
            font-family: "DejaVu Sans"; font-size: 11px;
            vertical-alignment: center; overflow: elide;
        }
        focus := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Return || event.text == " " { root.enter(); return accept; }
                return reject;
            }
        }
        touch := TouchArea { clicked => { focus.focus(); root.enter(); } }
    }
}
