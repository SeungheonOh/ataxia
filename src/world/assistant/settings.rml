<rml><head><title>Model settings</title><style>
body { margin:0; width:100%; height:100%; font-family:DejaVu Sans; font-size:13dp; color:#24282d; }
div { display:block; box-sizing:border-box; }
#settings-layer { position:absolute; left:0; right:0; top:0; bottom:0; display:flex; align-items:center; justify-content:center; }
#settings-backdrop { position:absolute; left:0; right:0; top:0; bottom:0; background:#1d253340; }
#dialog { position:relative; z-index:1; width:420dp; max-width:94%; padding:22dp; background:#fff; border:1dp #d4d8dc; border-radius:6dp; }
#dialog-header, #speed-row, #dialog-actions { display:flex; align-items:center; gap:12dp; }
#dialog-heading { font-size:17dp; font-weight:bold; }
button { display:block; box-sizing:border-box; height:32dp; line-height:32dp; padding:0 12dp; background:#f0f2f4; color:#424950; border-radius:3dp; text-align:center; }
button:hover { background:#e3e7eb; } button:active { background:#d4d8dc; }
button:focus { border:1dp #365dc0; }
#settings-close { margin-left:auto; width:28dp; height:28dp; line-height:26dp; padding:0; background:transparent; font-size:20dp; color:#626a73; }
#dialog-description { margin-top:7dp; margin-bottom:22dp; font-size:12dp; line-height:18dp; color:#626a73; }
.setting { margin-bottom:18dp; }
.setting-label { font-size:12dp; color:#424950; font-weight:bold; margin-bottom:7dp; }
#model-field, #effort-field { position:relative; width:100%; height:36dp; }
select { display:block; width:100%; height:36dp; box-sizing:border-box; background:#f7f8f9; border:1dp #d4d8dc; border-radius:3dp; color:#24282d; font-size:13dp; }
select:hover { background:#eef1f4; }
select selectvalue { padding:9dp 10dp; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
select selectarrow { width:28dp; }
#model-chevron, #effort-chevron { position:absolute; top:9dp; right:11dp; color:#626a73; pointer-events:none; }
select selectbox { background:#fff; border:1dp #b9c3d1; max-height:248dp; overflow-y:auto; z-index:20; }
select option { display:block; padding:10dp 12dp; color:#24282d; }
select option:hover, select option:checked { background:#eaf0ff; color:#244ebc; }
#models-load { margin-top:8dp; font-size:12dp; color:#244ebc; }
#speed-row { padding:3dp 0 18dp; border-bottom:1dp #e4e7eb; }
#speed-copy { flex:1; min-width:0; }
#speed-label { font-size:12dp; font-weight:bold; margin-bottom:5dp; }
#speed-description { font-size:11dp; color:#626a73; line-height:17dp; }
#fast { flex-shrink:0; min-width:78dp; height:30dp; line-height:28dp; border:1dp #cbd3dd; border-radius:15dp; background:#f0f2f4; font-size:11dp; }
#fast.enabled { background:#eaf0ff; border-color:#9db4ef; color:#244ebc; }
#fast.unavailable { background:#f4f5f6; color:#7c848e; border-color:#dfe3e7; }
#model-note { display:none; margin-top:12dp; color:#244ebc; font-size:11dp; line-height:18dp; }
#dialog-actions { margin-top:18dp; }
#saved-note { color:#68717b; font-size:11dp; }
#settings-done { margin-left:auto; background:#eaf0ff; color:#244ebc; min-width:66dp; }
scrollbarvertical { width:5dp; }
scrollbarvertical sliderbar { background:#aeb5bd; min-height:22dp; }
scrollbarvertical sliderarrowinc, scrollbarvertical sliderarrowdec { height:0; }
#dialog.small { padding:18dp; }
.small #dialog-heading { font-size:16dp; }
</style></head><body data-model="state"><div id="settings-layer">
<div id="settings-backdrop"/>
<div id="dialog"><div id="dialog-header"><div id="dialog-heading">Model settings</div><button id="settings-close">×</button></div>
<div id="dialog-description">Choose how the assistant handles your next task.</div>
<div id="model-setting" class="setting"><div class="setting-label">Model</div><div id="model-field" data-rml="model_options"><select id="model-select" data-value="selected_model"><option value="">Codex default</option></select><div id="model-chevron">▾</div></div><button id="models-load">Connect</button></div>
<div id="effort-setting" class="setting"><div class="setting-label">Reasoning effort</div><div id="effort-field" data-rml="effort_options"><select id="effort-select" data-value="selected_effort"><option value="">Auto</option></select><div id="effort-chevron">▾</div></div></div>
<div id="speed-row"><div id="speed-copy"><div id="speed-label">Fast mode</div><div id="speed-description">Faster responses, independent of effort.</div></div><button id="fast">Fast off</button></div>
<div id="model-note"/>
<div id="dialog-actions"><div id="saved-note">Changes save automatically</div><button id="settings-done" autofocus="autofocus">Done</button></div>
</div></div></body></rml>
