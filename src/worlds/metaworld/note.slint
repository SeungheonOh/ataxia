export component MetaworldNote inherits Window {
    background: transparent;
    in-out property <string> content: "";
    callback edited(string);
    Rectangle { border-width: 1px; border-color: #c7c7c7; border-radius: 7px; background: #ffffff; }
    Text { x: 12px; y: 8px; text: "NOTE"; font-family: "monospace"; font-size: 10px; color: #595959; }
    TextInput {
        x: 12px; y: 30px; width: parent.width - 24px; height: parent.height - 42px;
        text <=> root.content;
        color: #161616;
        font-size: 15px;
        wrap: word-wrap;
        selection-background-color: #bfbfbf;
        edited => { root.edited(self.text); }
    }
}
