import { Workstation } from "theme.slint";
export component SubworldHeader inherits Window {
    background: transparent;
    in property <string> caption;
    in property <bool> active: false;
    callback enter();
    Rectangle {
        background: touch.has-hover || focus.has-focus ? Workstation.ink : transparent;
        accessible-role: button;
        accessible-label: root.active ? "Back to Metaworld" : "Enter " + root.caption;
        forward-focus: focus;
        if root.active : Image { x: Workstation.inset; y: 0px; width: 16px; height: 16px; source: @image-url("icons/back.svg"); colorize: touch.has-hover || focus.has-focus ? Workstation.paper : Workstation.ink; }
        Text {
            x: Workstation.inset + (root.active ? 16px + Workstation.gap : 0px);
            width: max(0px, parent.width - self.x - Workstation.inset);
            text: root.caption; color: touch.has-hover || focus.has-focus ? Workstation.paper : Workstation.ink;
            font-family: "DejaVu Sans Mono"; font-size: 11px;
            vertical-alignment: center; overflow: elide;
        }
        focus := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Return || event.text == " " { root.enter(); return accept; }
                return reject;
            }
        }
        touch := TouchArea { clicked => { focus.focus(); root.enter(); } }
    }
}
