<rml><head><title>Ataxia assistant</title><style>
body { margin:0; width:100%; height:100%; font-size:14dp; }
div { display:block; box-sizing:border-box; }
#panel { width:100%; height:100%; border:var(--frame) var(--ink); display:flex; flex-direction:column; }
button { display:block; box-sizing:border-box; height:var(--control); line-height:var(--control-line); padding:0 var(--gap); flex-shrink:0; }
#header, #header-actions, #identity, #controls, #compose-actions, #footer, #connection-actions, #approval-actions { display:flex; align-items:center; gap:var(--gap); flex-shrink:0; }
#header { padding:var(--inset); }
#heading { font-size:var(--heading); font-weight:bold; }
#state { font-size:11dp; margin-top:var(--unit); }
#header-actions { margin-left:auto; }
#scope { font-size:11dp; max-width:120dp; overflow:hidden; text-overflow:ellipsis; }
#close { width:var(--control); padding:0; font-size:18dp; }
#scope-note { display:none; }
#project { display:none; box-sizing:border-box; margin:0 var(--inset) var(--gap); width:90%; height:var(--control); padding:6dp var(--gap); border:var(--frame) var(--ink); font-size:12dp; flex-shrink:0; }
#conversation { flex:1; min-height:0; width:100%; overflow-y:auto; padding:var(--gap) var(--inset) var(--section); }
#transcript { line-height:22dp; word-break:break-word; }
.chat-message { margin-bottom:var(--section); }
.chat-role { font-size:11dp; font-weight:bold; margin-bottom:var(--unit); }
.chat-user-text { white-space:pre-wrap; }
.md-paragraph { margin-bottom:var(--gap); }
.md-heading { font-weight:bold; margin-top:var(--section); margin-bottom:var(--gap); line-height:24dp; }
.md-h1 { font-size:18dp; } .md-h2 { font-size:16dp; } .md-h3 { font-size:14dp; }
.md-strong { font-weight:bold; } .md-em { font-style:italic; }
.md-code { font-size:12dp; padding:0 var(--unit); }
.md-code-block { margin:var(--gap) 0; padding:var(--gap); }
.md-code-label { font-size:11dp; margin-bottom:var(--gap); }
.md-pre { font-size:12dp; line-height:20dp; white-space:pre-wrap; }
.md-list-row { display:flex; align-items:flex-start; gap:var(--gap); margin-bottom:var(--unit); }
.md-marker { display:block; width:16dp; flex-shrink:0; }
.md-list-body { flex:1; min-width:0; }
.md-quote { border-left:var(--frame) var(--ink); padding-left:var(--gap); margin:var(--gap) 0; }
.md-rule { border-top:var(--frame) var(--ink); margin:var(--section) 0; }
.md-table { margin:var(--gap) 0; border:var(--frame) var(--ink); }
.md-table-row { display:flex; border-bottom:var(--frame) var(--ink); }
.md-table-heading { font-weight:bold; }
.md-table-cell { flex:1; min-width:0; padding:var(--gap); font-size:12dp; }
#plan { display:none; white-space:pre-wrap; font-size:12dp; line-height:20dp; margin-top:var(--gap); }
#activity { display:none; font-size:12dp; line-height:20dp; margin:var(--gap) 0; }
#request { display:none; border:var(--frame) var(--ink); padding:var(--inset); margin:var(--section) 0; }
#question { white-space:pre-wrap; line-height:20dp; margin-bottom:var(--gap); }
#choices { display:flex; flex-direction:column; gap:var(--gap); }
.choice { display:none; width:100%; height:auto; min-height:var(--control); line-height:20dp; padding:var(--gap); text-align:left; white-space:normal; }
#approval-actions { margin-top:var(--gap); }
#controls { display:none; margin:0 var(--inset) var(--gap); }
#pause, #stop, #undo { font-size:11dp; }
#undo { margin-left:auto; }
#compose { margin:0 var(--inset); flex-shrink:0; }
#message { display:block; box-sizing:border-box; width:100%; height:80dp; padding:var(--gap); border:var(--frame) var(--ink); font-size:14dp; line-height:20dp; }
#compose-actions { padding-top:var(--gap); }
#settings-open, #talk { font-size:11dp; }
#mic-status { display:none; }
#send { margin-left:auto; font-size:12dp; }
#footer { padding:var(--gap) var(--inset) var(--inset); font-size:10dp; }
#details { margin-left:auto; font-size:10dp; }
#hint { font-size:10dp; }
#limits { display:none; font-size:10dp; line-height:16dp; margin-top:var(--gap); }
#connection-actions { display:none; margin:var(--gap) 0; }
#login, #retry { font-size:12dp; }
.small #scope { max-width:72dp; }
.small #hint { max-width:180dp; white-space:normal; }
</style><link type="text/rcss" href="../rmlui/theme.rcss"/></head><body class="shell assistant-panel" data-model="state"><div id="panel">
<div id="header"><div id="identity"><div><div id="heading">Assistant</div><div id="state">Ready</div></div></div><div id="header-actions"><button id="scope">Desktop</button><button id="close">×</button></div><div id="scope-note"/></div>
<input id="project" type="text" data-value="project" placeholder="Project directory"/>
<div id="conversation"><div id="transcript" data-rml="transcript"/><div id="plan"/><div id="activity"/>
<div id="connection-actions"><button id="login">Sign in</button><button id="retry">Retry</button></div>
<div id="request"><div id="question"/><div id="choices"><button id="choice0" class="choice"/><button id="choice1" class="choice"/><button id="choice2" class="choice"/><button id="choice3" class="choice"/><button id="choice4" class="choice"/><button id="choice5" class="choice"/></div><div id="approval-actions"><button id="allow">Allow once</button><button id="deny">Deny</button></div></div><div id="limits"/></div>
<div id="controls"><button id="pause">Pause</button><button id="stop">Stop</button><button id="undo">Undo layout</button></div>
<div id="compose"><textarea id="message" data-value="message" autofocus="autofocus" placeholder="Describe a task…"/>
<div id="compose-actions"><button id="settings-open">Model settings</button><button id="talk">Voice</button><div id="mic-status">Microphone off</div><button id="send">Send</button></div></div>
<div id="footer"><div id="hint">Esc close · Ctrl+Alt+Esc pause all</div><button id="details">Details</button></div>
</div></body></rml>
