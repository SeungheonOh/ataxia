<rml><head><title>Agent cursor</title><style>
body { --accent:var(--ink); margin:0; width:100%; height:100%; font-size:11dp; }
div { display:block; }
#tag { position:absolute; left:0; top:0; right:0; bottom:0; padding:6dp 8dp; border:2dp var(--ink); border-left:3dp var(--accent); }
#name { font-weight:bold; font-size:11dp; }
#state { font-size:10dp; margin-top:3dp; }
#tag.clicked { animation:0.25s linear 1 click; }
</style><link type="text/rcss" href="../rmlui/theme.rcss"/></head><body class="shell computer-use-cursor"><div id="tag"><div id="name">Agent</div><div id="state">Connected</div></div></body></rml>
