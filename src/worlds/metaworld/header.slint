export component SubworldHeader inherits Window {
    background: transparent;
    in property <string> caption;
    in property <bool> active: false;
    private property <bool> compact: root.width < 220px;
    callback enter();
    Rectangle {
        background: transparent;
        Text {
            x: 4px;
            width: parent.width - (root.compact ? 8px : 108px);
            text: root.caption;
            color: root.active ? #161616 : #505050;
            font-size: 14px;
            font-family: "monospace";
            font-weight: root.active ? 700 : 500;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            x: parent.width - 104px;
            width: 52px;
            text: !root.compact && touch.has-hover ? (root.active ? "Leave" : "Enter") : "";
            color: #161616;
            font-size: 11px;
            font-family: "DejaVu Sans Mono";
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Text {
            x: parent.width - 40px;
            width: 32px;
            text: !root.compact && touch.has-hover ? "···" : "";
            color: #161616;
            font-size: 19px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        touch := TouchArea { clicked => { root.enter(); } }
    }
}
